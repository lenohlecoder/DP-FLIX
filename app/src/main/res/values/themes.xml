<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Thème minimal, volontairement sans dépendance à la lib Material Components XML
        (le projet est 100% Compose / Compose for TV côté UI, voir §2 du cahier des charges).
        Sert uniquement de thème d'activité (fenêtre plein écran, pas de barre d'action).
    -->
    <style name="Theme.DpFlix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <!--
            Complement du mode immersif de PlayerScreen (§4.5) : sans ceci, sur les
            appareils a encoche/poinçon, le systeme continue par defaut d'eviter la zone
            de la decoupe meme fenetre edge-to-edge - le contenu ne remplirait alors pas
            vraiment tout l'ecran en plein ecran paysage. "shortEdges" (API 28+, ignore
            sans effet sur les API plus anciennes) autorise le contenu a s'etendre
            derriere la decoupe sur les bords courts (typiquement le haut, la ou vit
            l'encoche) tout en la laissant geree normalement ailleurs.
        -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>

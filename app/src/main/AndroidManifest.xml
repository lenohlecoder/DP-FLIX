<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- §2.1 du cahier des charges : permissions déclarées dès le squelette -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Fix (13 août 2026) : requis à partir d'Android 14 (API 34) pour que
         FilmDownloadWorker puisse passer en foreground service via setForeground()
         avec ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC (téléchargement de fichiers,
         pas de lecture média). Sans cette permission, setForeground() lève une
         ForegroundServiceStartNotAllowedException sur API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        L'app doit fonctionner aussi bien sur téléphone/tablette (tactile) que sur
        boîtier Android TV (D-pad, pas forcément d'écran tactile) : aucune des deux
        fonctionnalités n'est donc "required" au sens du Play Store / du système.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".DpFlixApplication"
        android:label="DP-Flix"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!--
            §7 étape 2c-1 du cahier des charges : adaptive icon mobile (mipmap-anydpi-v26,
            API 26+, avec fallback vecteur combiné mipmap-anydpi pour API 23-25) et
            banner TV définitif (320x180dp), remplaçant les placeholders de l'étape 2b.
        -->

        <!--
            Fix (25 juillet 2026, vague 1 "stop crash") : android:configChanges sur les deux
            Activities. Sans ça, une rotation d'écran pendant la lecture détruit/recrée
            l'Activity (donc le PlayerController/ExoPlayer complet) au lieu de laisser
            l'app gérer le changement elle-même — ça n'est pas la cause principale du
            crash OOM (voir le fix EpgRepository/EpgXmlParser du même jour), mais ça
            aggrave un pic mémoire déjà tendu sur un mobile bas/moyen de gamme en cours
            de lecture. README-fix-programme-en-cours-accueil.md affirmait cet attribut
            déjà livré ; vérifié absent du manifeste réel (voir le diagnostic, point 5a) —
            correctif effectivement appliqué ici.
        -->

        <!-- Point d'entrée MOBILE (téléphone / tablette, tactile) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@style/Theme.DpFlix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Point d'entrée TV (boîtier Android TV, télécommande / D-pad) -->
        <activity
            android:name=".tv.TvMainActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@style/Theme.DpFlix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Fix (13 août 2026, build lintVitalRelease). WorkManager déclare son propre
            SystemForegroundService (androidx.work.impl.foreground.SystemForegroundService)
            dans son manifeste sans foregroundServiceType. FilmDownloadWorker appelle
            setForeground() avec FOREGROUND_SERVICE_TYPE_DATA_SYNC (voir createForegroundInfo
            dans FilmDownloadWorker.kt), mais lint (SpecifyForegroundServiceType) exige que ce
            type soit aussi déclaré ici, sur l'entrée <service> elle-même — sans quoi le build
            release échoue. tools:node="merge" fusionne avec l'entrée fournie par la librairie
            au lieu de la dupliquer.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

</manifest>
